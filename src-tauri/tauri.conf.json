{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShutterNet",
  "version": "0.1.0",
  "identifier": "dev.shutternet.desktop",
  "build": {
    "beforeDevCommand": "python -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:8000",
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "ShutterNet",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
